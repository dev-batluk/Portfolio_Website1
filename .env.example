# Единственная обязательная переменная: токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Необязательно: дополнительные chat ID (через запятую), которые всегда получают заявки
# TELEGRAM_CHAT_ID=

# Необязательно: свой секрет для проверки Telegram Webhook (по умолчанию вычисляется из токена)
# TELEGRAM_WEBHOOK_SECRET=

# Необязательно: установите false, чтобы отключить авто-регистрацию webhook на продакшене
# TELEGRAM_AUTO_WEBHOOK=true

# Необязательно (для Vercel): Upstash Redis / Vercel KV для постоянного хранения подписчиков
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
